{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DeployOnlyNamedQuietPilotStacks",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateChangeSet",
        "cloudformation:CreateStack",
        "cloudformation:DeleteChangeSet",
        "cloudformation:DescribeChangeSet",
        "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStackResources",
        "cloudformation:DescribeStacks",
        "cloudformation:ExecuteChangeSet",
        "cloudformation:GetTemplate",
        "cloudformation:ListStackResources",
        "cloudformation:UpdateStack",
        "cloudformation:UpdateTerminationProtection"
      ],
      "Resource": [
        "arn:aws:cloudformation:ap-northeast-2:424792720291:stack/QuietPilotData/*",
        "arn:aws:cloudformation:ap-northeast-2:424792720291:stack/QuietPilotApi/*",
        "arn:aws:cloudformation:ap-northeast-2:424792720291:stack/QuietPilotSchedule/*",
        "arn:aws:cloudformation:ap-northeast-2:424792720291:stack/QuietPilotObservability/*",
        "arn:aws:cloudformation:ap-northeast-2:424792720291:stack/AgentCore-QuietPilot-dev/*"
      ]
    },
    {
      "Sid": "ReadCloudFormationMetadata",
      "Effect": "Allow",
      "Action": [
        "cloudformation:GetTemplateSummary",
        "cloudformation:ListExports",
        "cloudformation:ListImports",
        "cloudformation:ValidateTemplate"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-2"
        }
      }
    },
    {
      "Sid": "PassOnlyTheBootstrapCloudFormationRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::424792720291:role/cdk-hnb659fds-cfn-exec-role-424792720291-ap-northeast-2",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "cloudformation.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ReadQuietPilotAssets",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::cdk-hnb659fds-assets-424792720291-ap-northeast-2",
        "arn:aws:s3:::cdk-hnb659fds-assets-424792720291-ap-northeast-2/*"
      ]
    },
    {
      "Sid": "ReadBootstrapVersion",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters"
      ],
      "Resource": "arn:aws:ssm:ap-northeast-2:424792720291:parameter/cdk-bootstrap/hnb659fds/version"
    },
    {
      "Sid": "IdentifySession",
      "Effect": "Allow",
      "Action": "sts:GetCallerIdentity",
      "Resource": "*"
    }
  ]
}
