  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "format": "prettier --write app src components *.json *.js *.ts",
    "format:check": "prettier --check app src components *.json *.js *.ts",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "doctor": "expo-doctor"
